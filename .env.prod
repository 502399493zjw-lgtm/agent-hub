# =============================================
# 生产环境配置（部署到 ECS，仅覆盖差异变量）
# 共享变量在 .env 中维护
# =============================================

# ── 应用 URL ───────────────────────────────────
NEXTAUTH_URL=https://openclawmp.cc

# ── 运行时配置 ─────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ── Next.js 配置 ───────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ── 可选：生产环境特殊配置 ─────────────────────────
# DATABASE_URL=/app/data/hub.db  # Docker volume 挂载路径
